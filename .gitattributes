# Set default behaviour, in case users don't have core.autocrlf set.
* text=auto

# Explicitly declare text files we want to always be normalized and converted 
# to native line endings on checkout.
*.c text
*.h text
*.cpp text
*.m text
*.mm text
*.pbxproj text
*.gitattributes text
*.mk text
*.lc text
*.xml text
*.md text
*.livecodescript text
*.lcdoc text
*.mlc text
*.lcb text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.vcproj text eol=crlf
*.vsprops text eol=crlf
*.rules text eol=crlf
# cmd.exe can mis-handle labels (goto, call :label) in LF-only batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf
*.inc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# The Linux package's launcher (a sh script without an extension), install
# scripts, desktop entry, MIME types and library list
Installer/linux/** text eol=lf

# These files are processed by cygwin+bash so make sure they don't end with CRLF
prebuilt/versions/* text eol=lf
prebuilt/SHA256SUMS text eol=lf
prebuilt/cef-sha1sums text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.rev binary
*.livecode binary

# File types of the OpenXTalk Lite / OXT-Beyond IDE (ide/). Stacks and
# assets must be stored byte for byte; scripts and snippets are text.
*.oxtstack binary
*.oxtscript text
*.snippet text
*.ico binary
*.gif binary
*.pdf binary
*.ttf binary
*.otf binary
*.sqlite binary
*.mp4 binary
*.zip binary



# HyperCard stacks, the HyperCard importer's test input, are binary (BinHex
# files too: their Mac line endings must not change).
*.stack binary
*.hqx binary
# and so are the synthetic resource forks beside them (make-forks.py)
*.rsrc binary
*.appledouble binary
*.applesingle binary
*.hfs binary
*.dc42 binary
*.apm binary

# stack-scripts/ (tools/oxt/stack_scripts.py) is made from the binary IDE
# stacks byte for byte, a CR inside a script included, and CI compares it
# byte for byte: Git must not change its line endings
stack-scripts/** -text
