-- Foreign handlers that return a CBool, a one-byte result (foreign-cbool.livecodescript)
library com.livecode.lcs_tests.core.extensions.foreign_cbool

use com.livecode.foreign

foreign handler MCMemoryAllocate(in pSize as UIntSize, out rBlock as Pointer) returns CBool binds to "<builtin>"
foreign handler MCMemoryDeallocate(in pBlock as Pointer) returns nothing binds to "<builtin>"
foreign handler MCDataCreateWithBytes(in pBytes as Pointer, in pCount as CUInt, out rData as Data) returns CBool binds to "<builtin>"

-- Allocates 16 bytes, makes Data of 3 of them, and frees the block: both
-- engine functions return true
public handler TestForeignCBoolResults() returns List
	variable tBlock as Pointer
	variable tAllocated as Boolean
	variable tCreated as Boolean
	variable tData as Data
	put false into tCreated
	unsafe
		put MCMemoryAllocate(16, tBlock) into tAllocated
		if tAllocated then
			put MCDataCreateWithBytes(tBlock, 3, tData) into tCreated
			MCMemoryDeallocate(tBlock)
		end if
	end unsafe
	if not tCreated then
		put the empty data into tData
	end if
	return [tAllocated, tCreated, the number of bytes in tData]
end handler

end library
