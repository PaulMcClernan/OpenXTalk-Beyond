<?lc
-- OXT-Beyond: compiles every script-only stack of the plugin packages on
-- another xTalk's engine, run by that engine's server build (for example
-- LiveCode Community 9.6.3's livecode-server), so that a script that uses
-- syntax only OXT-Beyond's engine knows is found before anyone installs a
-- package there. .github/workflows/plugin-packages.yml runs it.
--
--    livecode-server tools/plugins/stock-compile-check.lc <folder>
--
-- <folder> holds the packages unpacked, one folder each. Every
-- .livecodescript under it is read, its first line (script "<name>") taken
-- off, and the rest set as the script of a button of a scratch stack, as
-- the IDE's compile check does (tools/ci/ide-compile-check.livecodescript),
-- with explicitVariables false, as the IDE loads scripts. Nothing of it
-- runs. One line per file, OK or ERROR with the compiler's first error,
-- then a SUMMARY line; the exit code is 1 when a file did not compile and
-- 2 when nothing was found.

local sErrors, sFiles

set the explicitVariables to false
put 0 into sErrors
put 0 into sFiles
put $1 into tRoot
replace "\" with "/" in tRoot
if tRoot is empty or there is not a folder tRoot then
   put "usage: livecode-server stock-compile-check.lc <folder>" & return
   quit 2
end if
put "INFO version=" & the version & " build=" & the buildNumber & " environment=" & the environment & return
create stack "xtpcCompileScratch"
set the defaultStack to "xtpcCompileScratch"
create button "Check"
checkFolder tRoot, empty
put "SUMMARY files=" & sFiles & " errors=" & sErrors & return
if sFiles is 0 then
   quit 2
end if
if sErrors > 0 then
   quit 1
end if
quit 0

on checkFolder pFolder, pRel
   local tName, tSub
   repeat for each line tName in files(pFolder)
      if tName ends with ".livecodescript" then
         checkFile pFolder & "/" & tName, pRel & tName
      end if
   end repeat
   repeat for each line tSub in folders(pFolder)
      if tSub is among the items of ".,.." then
         next repeat
      end if
      checkFolder pFolder & "/" & tSub, pRel & tSub & "/"
   end repeat
end checkFolder

on checkFile pPath, pRel
   local tText, tFirst, tResult, tError
   add 1 to sFiles
   put textDecode(url ("binfile:" & pPath), "UTF-8") into tText
   if char 1 of tText is numToCodepoint(65279) then
      delete char 1 of tText
   end if
   put line 1 of tText into tFirst
   if not (tFirst begins with "script ") then
      add 1 to sErrors
      put "ERROR " & pRel & " | line 1 | no script line" & return
      exit checkFile
   end if
   -- An empty first line keeps the compiler's line numbers the file's
   put empty into line 1 of tText
   try
      set the script of button "Check" of stack "xtpcCompileScratch" to tText
      put the result into tResult
   catch tError
      put "throw " & line 1 of tError into tResult
   end try
   if tResult is empty then
      put "OK " & pRel & return
   else
      add 1 to sErrors
      put "ERROR " & pRel & " | line " & item 2 of line 1 of tResult & " | " & \
            describe(item 1 of line 1 of tResult) & " | " & line 1 of tResult & return
   end if
end checkFile

function describe pCode
   local tText
   if pCode is not an integer then
      return pCode
   end if
   try
      put line pCode of the scriptParsingErrors into tText
   catch tError
   end try
   return tText
end describe
?>
