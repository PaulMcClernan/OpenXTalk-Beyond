script "@COMPAT_STACK@"
-- OXT-Beyond: what lets @MENU_TITLE@ (@MAIN_STACK@) run in the IDE of
-- another xTalk built on LiveCode Community 9 (LiveCode Community 9.x,
-- OpenXTalk, HyperXTalk and the like), when it is installed there as an
-- extension package (.lce) with the Extension Manager.
--
-- GENERATED by tools/plugins/build-plugin-packages.py from
-- tools/plugins/plugin-compat.livecodescript.in: edit that, not a package's
-- copy. It is only ever in a package; OXT-Beyond's own copy of the plugin
-- (ide/Extensions) has no such file, and the plugin's main stack loads this
-- one only when it is there, so nothing of it runs in OXT-Beyond's own
-- plugin.
--
-- It does two things, and only on an IDE that does not do them itself:
--
--  * The menu item. OXT-Beyond's menu bar lists the plugin in
--    Development > Plugins (revmenubar.livecodescript); another IDE lists
--    only the stacks of its Plugins folders there. So, when the menu bar
--    has no entry of its own for the plugin, this writes a small launcher
--    stack, named "@MENU_TITLE@", into the user's Plugins folder (the one
--    Preferences > Files & Memory names), which the IDE lists; choosing it
--    does what OXT-Beyond's entry does. The launcher is taken out again
--    when the extension is unloaded (uninstalled, or its "load on startup"
--    turned off), and a launcher this did not write is never touched.
--
--  * The Script Editor. OXT-Beyond's editor has revSEInsertText (insert
--    the code at the caret as one undoable step) and
--    revSEGetLastSelectedLine (the line the caret was last on); LiveCode
--    Community 9.6's has neither. This stack is in use (start using), so
--    a dispatch of either to an editor that lacks it reaches the handlers
--    below, which do the same through the editor's field "Script" with the
--    handlers LiveCode Community 9.6's field behavior has. An editor that
--    has its own handles the dispatch first and this is never reached.
--
--  * The IDE's name. The plugins say "OXT-Beyond" where they name the IDE,
--    to the user and to the model; xtpcHostName gives the name to say in
--    the IDE this package is installed in instead (OXT-Beyond on OXT-Beyond).
--
--  * A file that must outlive an upgrade. An installed package's folder is
--    named with its version, so a path into it that another program keeps
--    (Claude's settings name the MCP server's file) breaks when the next
--    version replaces it. xtpcStableCopy keeps a copy of such a file in
--    the user's ~/.oxt-beyond folder, where the bridge keeps its own file,
--    and brings the copy up to date.
--
-- Verified statically; needs a pass on LiveCode Community 9.6 and on
-- HyperXTalk (tools/plugins/README.md says what to try).

constant kMainStack = "@MAIN_STACK@"
constant kMenuTitle = "@MENU_TITLE@"
constant kMenuPick = "@MENU_PICK@"
-- The launcher's first lines name the extension that wrote it: a launcher
-- without this line was not written here and is left alone
constant kLauncherMark = "-- xtalk-plugin-launcher: @MAIN_STACK@"

-- Whether this loaded the launcher into the user's Plugins folder, so that
-- unloading takes out only what it put in
local sWroteLauncher
-- The IDE's name, once xtpcHostName has worked it out
local sHostName

-- Called by the main stack's extensionInitialize, once this stack is in use
command xtpcStart
   local tError
   put false into sWroteLauncher
   if xtpcMenuIsNative() then
      exit xtpcStart
   end if
   try
      xtpcWriteLauncher
   catch tError
      -- No launcher: the plugin still works, from the Message Box
      -- (dispatch kMenuPick to stack kMainStack)
   end try
end xtpcStart

-- Called by the main stack's extensionFinalize
command xtpcStop
   local tError
   if sWroteLauncher is not true then
      exit xtpcStop
   end if
   try
      xtpcDeleteLauncher
   catch tError
   end try
   put false into sWroteLauncher
end xtpcStop

-- True when the IDE's menu bar lists the plugin itself, as OXT-Beyond's
-- does: its script dispatches the plugin's menu message. The script is
-- read from the menu bar's stack when it is open, and otherwise from its
-- file, as the extensions load before the menu bar does.
function xtpcMenuIsNative
   local tScript, tFile, tError
   if there is a stack "revMenuBar" then
      put the script of stack "revMenuBar" into tScript
   else
      try
         put revEnvironmentToolsetPath() & "/palettes/menubar/revmenubar.livecodescript" into tFile
         if there is a file tFile then
            put url ("binfile:" & tFile) into tScript
         end if
      catch tError
      end try
   end if
   return tScript contains (quote & kMenuPick & quote)
end xtpcMenuIsNative

function xtpcLauncherPath
   local tFolder
   put revEnvironmentUserPluginsPath() into tFolder
   if tFolder is empty or tFolder is "/Plugins" then
      return empty
   end if
   return tFolder & slash & kMenuTitle & ".livecodescript"
end xtpcLauncherPath

private function xtpcLauncherText
   local tText
   put "script" && quote & kMenuTitle & quote & return after tText
   put kLauncherMark & return after tText
   put "-- Written by the" && kMenuTitle && "extension so that it is listed in" & return after tText
   put "-- Development > Plugins. It is taken out when the extension is" & return after tText
   put "-- uninstalled; it only opens the extension, and holds nothing." & return & return after tText
   put "on preOpenStack" & return after tText
   put "   set the visible of me to false" & return after tText
   put "end preOpenStack" & return & return after tText
   put "on openStack" & return after tText
   put "   send" && quote & "xtpcLaunch" & quote && "to me in 0 milliseconds" & return after tText
   put "end openStack" & return & return after tText
   put "on xtpcLaunch" & return after tText
   put "   close me" & return after tText
   put "   if there is a stack" && quote & kMainStack & quote && "then" & return after tText
   put "      dispatch" && quote & kMenuPick & quote && "to stack" && quote & kMainStack & quote & return after tText
   put "   else" & return after tText
   put "      answer warning" && quote & kMenuTitle && "is not loaded. Install it again with the Extension Manager, or delete this file:" & quote && "&& return & the effective filename of me" & return after tText
   put "   end if" & return after tText
   put "end xtpcLaunch" & return after tText
   return tText
end xtpcLauncherText

private command xtpcWriteLauncher
   local tPath, tFolder, tText, tOld
   put xtpcLauncherPath() into tPath
   if tPath is empty then
      exit xtpcWriteLauncher
   end if
   put xtpcLauncherText() into tText
   if there is a file tPath then
      put textDecode(url ("binfile:" & tPath), "UTF-8") into tOld
      if line 2 of tOld is not kLauncherMark then
         -- The user's own file of that name
         exit xtpcWriteLauncher
      end if
      put true into sWroteLauncher
      if tOld is tText then
         exit xtpcWriteLauncher
      end if
   end if
   set the itemDelimiter to slash
   put item 1 to -2 of tPath into tFolder
   if there is not a folder tFolder then
      revIDEEnsurePath tFolder
   end if
   put textEncode(tText, "UTF-8") into url ("binfile:" & tPath)
   if the result is not empty then
      exit xtpcWriteLauncher
   end if
   put true into sWroteLauncher
   xtpcRefreshPlugins
end xtpcWriteLauncher

private command xtpcDeleteLauncher
   local tPath, tOld
   put xtpcLauncherPath() into tPath
   if tPath is empty or there is not a file tPath then
      exit xtpcDeleteLauncher
   end if
   put textDecode(url ("binfile:" & tPath), "UTF-8") into tOld
   if line 2 of tOld is not kLauncherMark then
      exit xtpcDeleteLauncher
   end if
   delete file tPath
   xtpcRefreshPlugins
end xtpcDeleteLauncher

-- Lists the Plugins folders again, so that the menu shows the change now;
-- at startup the IDE lists them itself after the extensions are loaded
private command xtpcRefreshPlugins
   local tError
   if there is not a stack "revMenuBar" then
      exit xtpcRefreshPlugins
   end if
   try
      revIDEUpdatePlugins
   catch tError
   end try
end xtpcRefreshPlugins

--------------------------------------------------------------------------------
-- The Script Editor, where it does not have these itself

-- As OXT-Beyond's revSEInsertText (revsestackbehavior) and the
-- textInsertAtLastSelection it calls (revsecommoneditorbehavior): pText
-- goes where the caret last was, in place of what was selected there, as
-- one step of the editor's undo; before the script was clicked in, at its
-- end. The target is the Script Editor's stack.
on revSEInsertText pText
   local tEditor, tFrom, tTo, tLocked, tFormat, tError
   if word 1 of the name of the target is not "stack" then
      pass revSEInsertText
   end if
   put the short name of the target into tEditor
   if pText is empty then
      exit revSEInsertText
   end if
   if there is not a field "Script" of stack tEditor then
      exit revSEInsertText
   end if
   dispatch function "scriptLocked" to field "Script" of stack tEditor
   put the result into tLocked
   if tLocked is true then
      exit revSEInsertText
   end if
   dispatch "getLastSelectedChunk" to field "Script" of stack tEditor
   put item 1 of the result into tFrom
   put item 2 of the result into tTo
   if tFrom is not an integer or tTo is not an integer then
      put the number of chars of field "Script" of stack tEditor + 1 into tFrom
      put tFrom - 1 into tTo
   end if
   put true into tFormat
   try
      dispatch function "sePrefGet" to stack "revNewScriptEditor" with "editor,autoformat"
      if the result is false then
         put false into tFormat
      end if
   catch tError
   end try
   lock screen
   dispatch "textBeginGroup" to field "Script" of stack tEditor with "Insert"
   dispatch "textReplace" to field "Script" of stack tEditor with tFrom, char tFrom to tTo of field "Script" of stack tEditor, pText
   if tFormat then
      dispatch "scriptFormat" to field "Script" of stack tEditor with "handler", true
   end if
   dispatch "textEndGroup" to field "Script" of stack tEditor
   unlock screen
end revSEInsertText

-- As OXT-Beyond's revSEGetLastSelectedLine: the line of the script being
-- edited that the caret was last on, or empty before it was clicked in
function revSEGetLastSelectedLine
   local tEditor, tFrom
   if word 1 of the name of the target is not "stack" then
      pass revSEGetLastSelectedLine
   end if
   put the short name of the target into tEditor
   if there is not a field "Script" of stack tEditor then
      return empty
   end if
   dispatch "getLastSelectedChunk" to field "Script" of stack tEditor
   put item 1 of the result into tFrom
   if tFrom is not an integer or tFrom < 1 then
      return empty
   end if
   return the number of lines of (char 1 to tFrom - 1 of field "Script" of stack tEditor & "x")
end revSEGetLastSelectedLine

--------------------------------------------------------------------------------
-- The IDE's name

-- OXT-Beyond where the menu bar lists the plugin itself; otherwise
-- HyperXTalk or OpenXTalk when the IDE's Toolset folder is named so (their
-- installs are), and LiveCode for LiveCode Community and the rest
function xtpcHostName
   local tPath, tError
   if sHostName is not empty then
      return sHostName
   end if
   if xtpcMenuIsNative() then
      put "OXT-Beyond" into sHostName
      return sHostName
   end if
   try
      put toLower(revEnvironmentToolsetPath()) into tPath
   catch tError
   end try
   if tPath contains "hyperxtalk" then
      put "HyperXTalk" into sHostName
   else if tPath contains "openxtalk" then
      put "OpenXTalk" into sHostName
   else
      put "LiveCode" into sHostName
   end if
   return sHostName
end xtpcHostName

--------------------------------------------------------------------------------
-- One MCP server per IDE

-- The name Claude's apps give the xTalk MCP Bridge's server in this IDE:
-- empty on OXT-Beyond, whose bridge keeps its own ("oxt-beyond"); else
-- the IDE's name in lower case ("livecode", "hyperxtalk", "openxtalk"),
-- so that two IDEs bridged on one computer are two servers in Claude
function xtpcServerName
   if xtpcHostName() is "OXT-Beyond" then
      return empty
   end if
   return toLower(xtpcHostName())
end xtpcServerName

-- The file that IDE's bridge writes its port and token to and its server
-- reads (the server is told it in OXT_MCP_BRIDGE_FILE): empty on
-- OXT-Beyond, whose bridge keeps ~/.oxt-beyond/mcp-bridge.json; else
-- ~/.oxt-beyond/mcp-bridge-<server name>.json
function xtpcBridgeFile
   if xtpcServerName() is empty then
      return empty
   end if
   return xtpcStableFolder() & "/mcp-bridge-" & xtpcServerName() & ".json"
end xtpcBridgeFile

--------------------------------------------------------------------------------
-- Files that outlive an upgrade

-- The user's folder for them: ~/.oxt-beyond, as the bridge's own file
-- (mcbInfoFilePath in mcpbridge-tools.livecodescript)
function xtpcStableFolder
   local tHome
   if the platform is "Win32" then
      put $USERPROFILE into tHome
      replace backslash with slash in tHome
   else
      put $HOME into tHome
   end if
   if tHome is empty then
      put specialFolderPath("home") into tHome
   end if
   return tHome & "/.oxt-beyond"
end xtpcStableFolder

-- Copies pSource to pName (a path such as "mcp/server.js") in the stable
-- folder when the copy is missing or differs, and gives the copy's path; or
-- pSource, when it could not be copied. With pOnlyIfThere true, a missing
-- copy is not made (an upgrade refreshes only a copy someone uses).
function xtpcStableCopy pSource, pName, pOnlyIfThere
   local tTarget, tFolder, tData, tPart, tPath, tError
   if pSource is empty or pName is empty or there is not a file pSource then
      return pSource
   end if
   put xtpcStableFolder() & "/" & pName into tTarget
   if pOnlyIfThere is true and there is not a file tTarget then
      return pSource
   end if
   try
      put url ("binfile:" & pSource) into tData
      if there is a file tTarget and url ("binfile:" & tTarget) is tData then
         return tTarget
      end if
      set the itemDelimiter to slash
      put item 1 to -2 of tTarget into tFolder
      -- Each folder of the path, from the top ("/home", or "C:/Users")
      repeat with tPart = 2 to the number of items of tFolder
         put item 1 to tPart of tFolder into tPath
         if there is not a folder tPath then
            create folder tPath
         end if
      end repeat
      put tData into url ("binfile:" & tTarget)
      if the result is not empty then
         return pSource
      end if
   catch tError
      return pSource
   end try
   return tTarget
end xtpcStableCopy
